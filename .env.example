# ─────────────────────────────────────────────────────────────────────────────
# DDSE — Environment Variables Template
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or any file containing real keys to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (Required) ───────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-key>

# ── Application (Optional) ────────────────────────────────────────────────────
VITE_APP_VERSION=2.5.0

# ── Feature Flags (Optional) ──────────────────────────────────────────────────
# VITE_ENABLE_AI_ANALYTICS=false
# VITE_ENABLE_REAL_TIME=false
# VITE_ENABLE_OFFLINE_SYNC=false
