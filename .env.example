APP_ORIGIN=http://localhost:5173

VITE_CONVEX_URL=https://your-deployment.convex.cloud
VITE_CONVEX_SITE_URL=https://your-deployment.convex.site
CONVEX_DEPLOYMENT=dev:your-deployment

# For localhost OTP flows, prefer a preview code instead of a fake provider.
DDSE_ENABLE_DEV_OTP_PREVIEW=true
VITE_ENABLE_DEV_OTP_PREVIEW=true

# Set a real OTP provider webhook in production-like environments.
OTP_DELIVERY_WEBHOOK_URL=

# Optional E2E credentials for role-sensitive localhost smoke coverage.
DDSE_E2E_ADMIN_APPOINTMENT=
DDSE_E2E_ADMIN_PASSWORD=
