# Local environment override for development and bootstrap.
# Do NOT commit real passwords or sensitive secrets.

# Convex endpoint for local development
VITE_CONVEX_URL=http://localhost:8080

# Secure bootstrap password for the Platform Owner account.
# This value is consumed by `scripts/bootstrap-platform.js`, the local bootstrap flow, and Convex auth bootstrap logic.
DDSE_BOOTSTRAP_OWNER_PASSWORD=YourSecureBootstrapPassword123!
VITE_DDSE_BOOTSTRAP_OWNER_PASSWORD=YourSecureBootstrapPassword123!
